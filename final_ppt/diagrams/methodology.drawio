<mxfile host="app.diagrams.net"><diagram name="Methodology"><mxGraphModel dx="2400" dy="1000" grid="1" gridSize="10" pageWidth="2400" pageHeight="1000"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="2" value="&lt;b&gt;User Inputs&lt;/b&gt;&lt;br&gt;District, season, farm size (ha)&lt;br&gt;Optional budget, preference or&lt;br&gt;TOPSIS profile / custom weights&lt;br&gt;&lt;i&gt;RunOptimizationView → POST /api/farm-plans&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;fillColor=#eaf2fc;strokeColor=#2a78d6;strokeWidth=2;fontSize=12;" vertex="1" parent="1"><mxGeometry x="30" y="140" width="300" height="210" as="geometry"/></mxCell><mxCell id="3" value="&lt;b&gt;Validation&lt;/b&gt;&lt;br&gt;Pydantic FarmPlanRequest: land &amp;gt; 0,&lt;br&gt;pop 8–300, generations 5–500&lt;br&gt;38 official districts; Kharif / Rabi&lt;br&gt;(Pollachi → taluk note, 400)&lt;br&gt;&lt;i&gt;app/schemas.py · preprocessing.resolve_location&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;fillColor=#eaf2fc;strokeColor=#2a78d6;strokeWidth=2;fontSize=12;" vertex="1" parent="1"><mxGeometry x="370" y="140" width="300" height="210" as="geometry"/></mxCell><mxCell id="4" value="&lt;b&gt;Official Dataset Loading&lt;/b&gt;&lt;br&gt;10 official raw files: Season &amp;amp; Crop&lt;br&gt;Report, IMD rainfall, WRD reservoirs,&lt;br&gt;groundwater, CACP MSP/cost, TNAU,&lt;br&gt;Soil Health Card → SQLite database&lt;br&gt;&lt;i&gt;app/datasets/pipeline.py build_database&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;fillColor=#e6f6ef;strokeColor=#1baf7a;strokeWidth=2;fontSize=12;" vertex="1" parent="1"><mxGeometry x="710" y="140" width="300" height="210" as="geometry"/></mxCell><mxCell id="5" value="&lt;b&gt;Dataset Registry&lt;/b&gt;&lt;br&gt;Per file: sha256, report year&lt;br&gt;2024-25, raw and clean rows;&lt;br&gt;ingestion_log of validation issues&lt;br&gt;Served by GET /api/datasets&lt;br&gt;&lt;i&gt;app/db/schema.py dataset_registry&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;fillColor=#e6f6ef;strokeColor=#1baf7a;strokeWidth=2;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1050" y="140" width="300" height="210" as="geometry"/></mxCell><mxCell id="6" value="&lt;b&gt;Cleaning &amp;amp; Normalisation&lt;/b&gt;&lt;br&gt;Validators and cleaners per dataset;&lt;br&gt;district / crop name keys, units;&lt;br&gt;official_view → crop, land, rainfall,&lt;br&gt;water frames (985 / 76 / 456 / 456)&lt;br&gt;&lt;i&gt;app/datasets/* · normalize.py · official_view.py&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;fillColor=#e6f6ef;strokeColor=#1baf7a;strokeWidth=2;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1390" y="140" width="300" height="210" as="geometry"/></mxCell><mxCell id="7" value="&lt;b&gt;District Selection&lt;/b&gt;&lt;br&gt;Season rainfall vs IMD normal,&lt;br&gt;reservoir storage %, groundwater,&lt;br&gt;Soil Health Card fertility index&lt;br&gt;for the chosen district and season&lt;br&gt;&lt;i&gt;preprocessing.get_region_season_profile&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;fillColor=#e6f6ef;strokeColor=#1baf7a;strokeWidth=2;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1730" y="140" width="300" height="210" as="geometry"/></mxCell><mxCell id="8" value="&lt;b&gt;Crop Filtering&lt;/b&gt;&lt;br&gt;Keep crops with official yield,&lt;br&gt;TNAU dose, MSP and CACP cost;&lt;br&gt;every exclusion keeps its reason;&lt;br&gt;6 candidates by default (2–12)&lt;br&gt;&lt;i&gt;preprocessing._candidate_mask&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;fillColor=#e6f6ef;strokeColor=#1baf7a;strokeWidth=2;fontSize=12;" vertex="1" parent="1"><mxGeometry x="2070" y="140" width="300" height="210" as="geometry"/></mxCell><mxCell id="9" value="&lt;b&gt;Fuzzy Logic&lt;/b&gt;&lt;br&gt;Mamdani model &amp;#x27;official&amp;#x27;: IMD&lt;br&gt;rainfall bands, data-percentile&lt;br&gt;storage and fertility sets →&lt;br&gt;yield confidence, irrigation risk&lt;br&gt;&lt;i&gt;app/fuzzy/engine.py · calibration.py&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;fillColor=#fdeee7;strokeColor=#eb6834;strokeWidth=2;fontSize=12;" vertex="1" parent="1"><mxGeometry x="2070" y="520" width="300" height="210" as="geometry"/></mxCell><mxCell id="10" value="&lt;b&gt;NSGA-II&lt;/b&gt;&lt;br&gt;4 objectives: yield, CACP cost,&lt;br&gt;irrigated area, nutrient load;&lt;br&gt;optional budget constraint;&lt;br&gt;pop 80 × 200 gen, pc 0.85, pm 0.12&lt;br&gt;&lt;i&gt;app/optimization/problem.py · nsga2_runner.py&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;fillColor=#fdeee7;strokeColor=#eb6834;strokeWidth=2;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1730" y="520" width="300" height="210" as="geometry"/></mxCell><mxCell id="11" value="&lt;b&gt;TOPSIS&lt;/b&gt;&lt;br&gt;Closeness to the ideal plan&lt;br&gt;over weighted criteria: balanced,&lt;br&gt;profit, water, sustainability,&lt;br&gt;low-cost or custom profile&lt;br&gt;&lt;i&gt;app/decision/ranking.py · topsis_service.py&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;fillColor=#fdeee7;strokeColor=#eb6834;strokeWidth=2;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1390" y="520" width="300" height="210" as="geometry"/></mxCell><mxCell id="12" value="&lt;b&gt;Ranking &amp;amp; Recommendation&lt;/b&gt;&lt;br&gt;Up to 50 ranked Pareto plans;&lt;br&gt;rank 1 = crop mix, areas, cost,&lt;br&gt;trade-off summary, confidence;&lt;br&gt;run saved as JSON + CSV&lt;br&gt;&lt;i&gt;ranking.to_dict_list · results_store.py&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;fillColor=#fdeee7;strokeColor=#eb6834;strokeWidth=2;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1050" y="520" width="300" height="210" as="geometry"/></mxCell><mxCell id="13" value="&lt;b&gt;Explainability Engine&lt;/b&gt;&lt;br&gt;Reasons, trade-offs, constraints,&lt;br&gt;risks, confidence, fuzzy rules,&lt;br&gt;TOPSIS contributions, per-crop&lt;br&gt;official evidence (10 criteria)&lt;br&gt;&lt;i&gt;explanation_service.py · crop_evidence.py&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;fillColor=#efedfb;strokeColor=#6250d6;strokeWidth=2;fontSize=12;" vertex="1" parent="1"><mxGeometry x="710" y="520" width="300" height="210" as="geometry"/></mxCell><mxCell id="14" value="&lt;b&gt;REST API&lt;/b&gt;&lt;br&gt;FastAPI: farm-plans, results,&lt;br&gt;explanation, comparison, district&lt;br&gt;intelligence, simulations,&lt;br&gt;datasets, soil-master&lt;br&gt;&lt;i&gt;app/main.py&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;fillColor=#efedfb;strokeColor=#6250d6;strokeWidth=2;fontSize=12;" vertex="1" parent="1"><mxGeometry x="370" y="520" width="300" height="210" as="geometry"/></mxCell><mxCell id="15" value="&lt;b&gt;React Dashboard&lt;/b&gt;&lt;br&gt;Dashboard, Run Optimization,&lt;br&gt;Analytics, Comparison, History,&lt;br&gt;Reports, District Intelligence,&lt;br&gt;Scenario Simulation, Official Data&lt;br&gt;&lt;i&gt;frontend/src/views (React 19 + Vite)&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;fillColor=#efedfb;strokeColor=#6250d6;strokeWidth=2;fontSize=12;" vertex="1" parent="1"><mxGeometry x="30" y="520" width="300" height="210" as="geometry"/></mxCell><mxCell id="16" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#8a8984;strokeWidth=2;fontSize=11;" edge="1" parent="1" source="2" target="3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="17" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#8a8984;strokeWidth=2;fontSize=11;" edge="1" parent="1" source="3" target="4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="18" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#8a8984;strokeWidth=2;fontSize=11;" edge="1" parent="1" source="4" target="5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="19" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#8a8984;strokeWidth=2;fontSize=11;" edge="1" parent="1" source="5" target="6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="20" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#8a8984;strokeWidth=2;fontSize=11;" edge="1" parent="1" source="6" target="7"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="21" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#8a8984;strokeWidth=2;fontSize=11;" edge="1" parent="1" source="7" target="8"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="22" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#8a8984;strokeWidth=2;fontSize=11;" edge="1" parent="1" source="8" target="9"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="23" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#8a8984;strokeWidth=2;fontSize=11;" edge="1" parent="1" source="9" target="10"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="24" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#8a8984;strokeWidth=2;fontSize=11;" edge="1" parent="1" source="10" target="11"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="25" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#8a8984;strokeWidth=2;fontSize=11;" edge="1" parent="1" source="11" target="12"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="26" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#8a8984;strokeWidth=2;fontSize=11;" edge="1" parent="1" source="12" target="13"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="27" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#8a8984;strokeWidth=2;fontSize=11;" edge="1" parent="1" source="13" target="14"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="28" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#8a8984;strokeWidth=2;fontSize=11;" edge="1" parent="1" source="14" target="15"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
