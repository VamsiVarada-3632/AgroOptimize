<mxfile host="app.diagrams.net"><diagram name="Module interaction"><mxGraphModel dx="2400" dy="1720" grid="1" gridSize="10" pageWidth="2400" pageHeight="1720"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="2" value="&lt;b&gt;React Frontend (frontend/src)&lt;/b&gt;&lt;br&gt;Views: Dashboard · Run Optimization · Analytics · Comparison · History · Reports · District Intelligence · Scenario Simulation · Official Data&lt;br&gt;services/api.js: the single place that calls the backend (fetch, same origin in production)" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;fillColor=#efedfb;strokeColor=#6250d6;strokeWidth=2;fontSize=12;" vertex="1" parent="1"><mxGeometry x="500" y="120" width="1400" height="120" as="geometry"/></mxCell><mxCell id="3" value="&lt;b&gt;FastAPI REST API (app/main.py)&lt;/b&gt;&lt;br&gt;POST /api/farm-plans · GET /api/results/{id} · /api/results/{id}/explanation · /api/results/{id}/topsis · /api/region-profile&lt;br&gt;GET /api/dashboard · /api/plans · /api/comparison · /api/compare-fuzzy · /api/district-intelligence · /api/history  (per district)&lt;br&gt;POST /api/simulations/run · GET /api/datasets · /api/soil-master · /api/fuzzy/explain · /api/fuzzy/audit · /health  (+ 501 if no official data)" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;fillColor=#efedfb;strokeColor=#6250d6;strokeWidth=2;fontSize=12;" vertex="1" parent="1"><mxGeometry x="30" y="330" width="2340" height="140" as="geometry"/></mxCell><mxCell id="4" value="HTTP / JSON" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#8a8984;strokeWidth=2;fontSize=11;" edge="1" parent="1" source="2" target="3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="5" value="&lt;b&gt;Plan service&lt;/b&gt;&lt;br&gt;Runs the pipeline per request:&lt;br&gt;preprocess → fuzzy → NSGA-II → TOPSIS&lt;br&gt;&lt;i&gt;app/services/plan_service.py&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;fillColor=#efedfb;strokeColor=#6250d6;strokeWidth=2;fontSize=12;" vertex="1" parent="1"><mxGeometry x="30" y="560" width="440" height="150" as="geometry"/></mxCell><mxCell id="6" value="&lt;b&gt;Explainability engine&lt;/b&gt;&lt;br&gt;Reasons, risks, confidence, fuzzy&lt;br&gt;rules, TOPSIS, per-crop evidence&lt;br&gt;&lt;i&gt;explanation_service.py · crop_evidence.py&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;fillColor=#efedfb;strokeColor=#6250d6;strokeWidth=2;fontSize=12;" vertex="1" parent="1"><mxGeometry x="505" y="560" width="440" height="150" as="geometry"/></mxCell><mxCell id="7" value="&lt;b&gt;TOPSIS service&lt;/b&gt;&lt;br&gt;Re-rank saved fronts, profiles,&lt;br&gt;custom weights, comparisons&lt;br&gt;&lt;i&gt;app/services/topsis_service.py&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;fillColor=#efedfb;strokeColor=#6250d6;strokeWidth=2;fontSize=12;" vertex="1" parent="1"><mxGeometry x="980" y="560" width="440" height="150" as="geometry"/></mxCell><mxCell id="8" value="&lt;b&gt;Dashboard / District / Simulation&lt;/b&gt;&lt;br&gt;KPI cards, Pareto plans, A/B/C,&lt;br&gt;district profile, what-if scenarios&lt;br&gt;&lt;i&gt;dashboard_ · district_ · simulation_service.py&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;fillColor=#efedfb;strokeColor=#6250d6;strokeWidth=2;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1455" y="560" width="440" height="150" as="geometry"/></mxCell><mxCell id="9" value="&lt;b&gt;Results store&lt;/b&gt;&lt;br&gt;Saved runs and simulations&lt;br&gt;(JSON + CSV + convergence)&lt;br&gt;&lt;i&gt;app/services/results_store.py → results/&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;fillColor=#efedfb;strokeColor=#6250d6;strokeWidth=2;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1930" y="560" width="440" height="150" as="geometry"/></mxCell><mxCell id="10" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#8a8984;strokeWidth=2;fontSize=11;" edge="1" parent="1" source="3" target="5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="11" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#8a8984;strokeWidth=2;fontSize=11;" edge="1" parent="1" source="3" target="6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="12" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#8a8984;strokeWidth=2;fontSize=11;" edge="1" parent="1" source="3" target="7"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="13" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#8a8984;strokeWidth=2;fontSize=11;" edge="1" parent="1" source="3" target="8"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="14" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#8a8984;strokeWidth=2;fontSize=11;" edge="1" parent="1" source="3" target="9"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="15" value="&lt;b&gt;Preprocessing&lt;/b&gt;&lt;br&gt;District + season profile: rainfall vs&lt;br&gt;IMD normal, reservoir %, soil index;&lt;br&gt;crop filtering with reasons&lt;br&gt;&lt;i&gt;app/data/preprocessing.py&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;fillColor=#e6f6ef;strokeColor=#1baf7a;strokeWidth=2;fontSize=12;" vertex="1" parent="1"><mxGeometry x="30" y="800" width="540" height="165" as="geometry"/></mxCell><mxCell id="16" value="&lt;b&gt;Fuzzy engine&lt;/b&gt;&lt;br&gt;Mamdani FIS (scikit-fuzzy), model&lt;br&gt;&amp;#x27;official&amp;#x27; calibrated on the data →&lt;br&gt;yield confidence, irrigation risk&lt;br&gt;&lt;i&gt;app/fuzzy/engine.py · calibration.py&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;fillColor=#fdeee7;strokeColor=#eb6834;strokeWidth=2;fontSize=12;" vertex="1" parent="1"><mxGeometry x="630" y="800" width="540" height="165" as="geometry"/></mxCell><mxCell id="17" value="&lt;b&gt;NSGA-II engine&lt;/b&gt;&lt;br&gt;pymoo NSGA-II, 4 objectives,&lt;br&gt;single-point crossover, Gaussian&lt;br&gt;mutation, quality metrics (HV, IGD+)&lt;br&gt;&lt;i&gt;app/optimization/&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;fillColor=#fdeee7;strokeColor=#eb6834;strokeWidth=2;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1230" y="800" width="540" height="165" as="geometry"/></mxCell><mxCell id="18" value="&lt;b&gt;TOPSIS ranking&lt;/b&gt;&lt;br&gt;Criteria, profiles, closeness,&lt;br&gt;per-criterion contributions,&lt;br&gt;plan-vs-plan explanation&lt;br&gt;&lt;i&gt;app/decision/&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;fillColor=#fdeee7;strokeColor=#eb6834;strokeWidth=2;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1830" y="800" width="540" height="165" as="geometry"/></mxCell><mxCell id="19" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#8a8984;strokeWidth=2;fontSize=11;" edge="1" parent="1" source="5" target="15"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="20" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#8a8984;strokeWidth=2;fontSize=11;" edge="1" parent="1" source="5" target="16"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="21" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#8a8984;strokeWidth=2;fontSize=11;" edge="1" parent="1" source="5" target="17"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="22" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#8a8984;strokeWidth=2;fontSize=11;" edge="1" parent="1" source="5" target="18"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="23" value="&lt;b&gt;Dataset service (official data access)&lt;/b&gt;&lt;br&gt;app/data/loader.py + official_view.py: crop, land, rainfall and water frames for the pipeline (cached per process)&lt;br&gt;app/datasets/service.py: SQL queries with TTL cache, provenance; soil_master · agronomy_master · conversion_loader&lt;br&gt;No CSV fallback: a missing dataset raises OfficialDataUnavailable → HTTP 501 for that feature" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;fillColor=#e6f6ef;strokeColor=#1baf7a;strokeWidth=2;fontSize=12;" vertex="1" parent="1"><mxGeometry x="300" y="1050" width="1800" height="140" as="geometry"/></mxCell><mxCell id="24" value="reads" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#8a8984;strokeWidth=2;fontSize=11;" edge="1" parent="1" source="15" target="23"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="25" value="calibration" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#8a8984;strokeWidth=2;fontSize=11;" edge="1" parent="1" source="16" target="23"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="26" value="&lt;b&gt;SQLite database official_v1.db&lt;/b&gt;&lt;br&gt;16 tables via SQLAlchemy (AGROOPTIMIZE_DB_URL)&lt;br&gt;dataset_registry (sha256, rows, report year),&lt;br&gt;ingestion_log, district, crop_stat, msp, reservoir …" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;fillColor=#e6f6ef;strokeColor=#1baf7a;strokeWidth=2;fontSize=12;" vertex="1" parent="1"><mxGeometry x="300" y="1270" width="860" height="140" as="geometry"/></mxCell><mxCell id="27" value="&lt;b&gt;Build pipeline (once, and at Docker build)&lt;/b&gt;&lt;br&gt;scripts/preprocess_all.py → build_database():&lt;br&gt;per dataset validate → clean → import;&lt;br&gt;validation_report.json" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;fillColor=#e6f6ef;strokeColor=#1baf7a;strokeWidth=2;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1240" y="1270" width="860" height="140" as="geometry"/></mxCell><mxCell id="28" value="SQL" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#8a8984;strokeWidth=2;fontSize=11;" edge="1" parent="1" source="23" target="26"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="29" value="writes" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#8a8984;strokeWidth=2;fontSize=11;" edge="1" parent="1" source="27" target="26"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="30" value="&lt;b&gt;Official government datasets (data/official/raw, report year 2024-25)&lt;/b&gt;&lt;br&gt;TN Season &amp;amp; Crop Report (crops, state series, land use, irrigation, IMD rainfall) · groundwater levels · WRD daily reservoir levels&lt;br&gt;CACP MSP and cost of cultivation · TNAU Crop Production Guide doses · Soil Health Card 2024-25 · agronomy / soil masters, conversion table" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;fillColor=#e6f6ef;strokeColor=#1baf7a;strokeWidth=2;fontSize=12;" vertex="1" parent="1"><mxGeometry x="300" y="1470" width="1800" height="120" as="geometry"/></mxCell><mxCell id="31" value="read raw files" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#8a8984;strokeWidth=2;fontSize=11;" edge="1" parent="1" source="30" target="27"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
